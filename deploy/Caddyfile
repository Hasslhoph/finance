{
	# UDP 443 занят AmneziaWG, поэтому HTTP/3 (QUIC) выключаем — иначе Caddy
	# не сможет занять порт. Работаем на TCP: h1 + h2.
	servers {
		protocols h1 h2
	}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		root * /opt/family-finance/web
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/family-finance.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
